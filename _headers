# Canonical hints for the JN lab app pages (their HTML has no <link rel="canonical">).
# Cloudflare Pages applies these to static responses; Google honors rel="canonical" in the Link header.
/cipherladder/
  Link: <https://www.jamesnetworks.net/cipherladder/>; rel="canonical"
/flowscout/
  Link: <https://www.jamesnetworks.net/flowscout/>; rel="canonical"
/netnudge/
  Link: <https://www.jamesnetworks.net/netnudge/>; rel="canonical"
/pool/
  Link: <https://www.jamesnetworks.net/pool/>; rel="canonical"

# /book and /method are kept (restyled) but unlisted: keep them out of search indexes.
/book
  X-Robots-Tag: noindex
/book/*
  X-Robots-Tag: noindex
/method
  X-Robots-Tag: noindex
/method/*
  X-Robots-Tag: noindex

# Preview hosts (*.pages.dev) are never indexed. Production hosts are unaffected.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:branch.:project.pages.dev/*
  X-Robots-Tag: noindex
